# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
backups/

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Scripts utilitaires locaux (accès Supabase via .env.local — jamais dans le dépôt).
# Les scripts de sauvegarde (backup-db.ps1/.sh) restent suivis car non .js.
scripts/*.js

# Log du serveur de dev
devserver.log

# Claude Code — réglages personnels locaux (launch.json reste suivi, partageable)
.claude/settings.local.json
