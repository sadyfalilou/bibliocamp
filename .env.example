NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Courriels autorisés à accéder à /admin/reports (séparés par des virgules)
ADMIN_EMAILS=toi@example.com

TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=VAxxx

# Sentry (optionnel — les erreurs ne sont capturées qu'en production si défini)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/xxx
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/xxx
SENTRY_ORG=ton-org-sentry
SENTRY_PROJECT=bibliocamp
SENTRY_AUTH_TOKEN=sntrys_xxx
